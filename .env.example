# =============================================================================
# Polina Pastry — environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Find these in Supabase Studio → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Service-role / secret key — NEVER expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Order notifications go to POLINA_EMAIL. Outgoing emails are sent through
# this same Gmail account using a Google App Password.

POLINA_EMAIL="polina.pastry1@gmail.com"

# 16-character App Password from https://myaccount.google.com/apppasswords.
# Requires 2-Step Verification to be enabled on the Gmail account first.
# This is NOT the Gmail login password.
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# ── Stripe ──────────────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys.
# Switch to live keys only after Polina completes business verification.
STRIPE_SECRET_KEY="sk_test_..."

# Only needed in production (Vercel). Locally we infer the URL from request
# headers, so leave commented out unless deployed.
# NEXT_PUBLIC_SITE_URL="https://polina-pastry.vercel.app"
